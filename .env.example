# PromptPilot environment variables. Copy to .env.local for local dev.
# Every key is optional: the template prompt builder works with none of them.
# Never commit real values. Server-only secrets must NOT start with NEXT_PUBLIC_.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAKER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (auth, saved prompts, library). Apply supabase/migrations/ in order first. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: enables shared daily rate limits (consume_run_quota). Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# --- Run button providers (server only, free tiers) ---
GROQ_API_KEY=
GROQ_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
RUN_ENABLE_GEMINI=
# Salt for hashing client IPs in quota rows (any long random string)
RUN_IP_SALT=
RUN_LOG_CALLS=

# --- Cloudflare Turnstile (bot check on Run) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron (/api/keep-alive). Vercel sets this automatically for cron jobs. ---
CRON_SECRET=

# --- Search Console / Bing Webmaster (optional). Content token only, not the full meta tag. ---
# Leave unset to omit the tags. Set in Vercel after copying the token from the dashboard, then redeploy.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
