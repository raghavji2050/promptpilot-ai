# Public site URL used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Supabase (auth + saved prompts). Leave empty to run without accounts.
# Apply ../schema.sql to your Supabase project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
